# Jupyter
notebooks/
*.ipynb

# Generated chart cache (rebuilt at runtime)
data/charts/

# ChromaDB vector store (rebuilt by build_index.py or mounted as a volume)
nlp_frammer/data/chroma_db/

# Test artefacts
.pytest_cache/
*.log
