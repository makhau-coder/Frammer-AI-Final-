dashboard/

# Environment — never commit secrets
.env
venv/

# Jupyter
.ipynb_checkpoints/

# Database files inside database/ subfolder only
# (frammer_analytics.duckdb and registry.db in the root ARE committed)
database/*.db

# OS
.DS_Store
Thumbs.db
